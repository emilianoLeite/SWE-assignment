{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "paths": {
          "@textyess/models": ["../../packages/models/src/index.ts"]
        }
      }
    }]
  },
  "moduleNameMapper": {
    "^@textyess/models$": "<rootDir>/../../packages/models/src/index.ts"
  }
}
